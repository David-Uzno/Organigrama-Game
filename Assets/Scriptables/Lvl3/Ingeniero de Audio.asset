  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1199b8403608a1d42a0627ae3bab90e2, type: 3}
  m_Name: Ingeniero de Audio
  m_EditorClassIdentifier: 
  dialogueLines:
  - SpeakerName: Ingeniero de Audio
    Line: "Mi trabajo es que todo suene claro y en el balance perfecto:\nque la m\xFAsica
      no tape a los efectos,\nque los pasos no sean m\xE1s fuertes que un boss,\n"
    audioClips:
    - clip: {fileID: 8300000, guid: ef0bcd3493907434dbfd933590c2703f, type: 3}
      dontInterruptOnNext: 0
  - SpeakerName: Ingeniero de Audio
    Line: "y que puedas disfrutar el sonido sin distraerte.\nSi el juego suena limpio\u2026
      estoy haciendo bien mi trabajo."
    audioClips:
    - clip: {fileID: 8300000, guid: ef0bcd3493907434dbfd933590c2703f, type: 3}
      dontInterruptOnNext: 0
