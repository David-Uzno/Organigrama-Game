      objectReference: {fileID: 195229184}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _speakerText
      value: 
      objectReference: {fileID: 1886556828}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueData
      value: 
      objectReference: {fileID: 11400000, guid: 2c4478580f09ee24094c59fab394b1cf, type: 2}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueText
      value: 
      objectReference: {fileID: 80255629}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[0].line
      value: " \xA1Atenci\xF3n!\r"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[1].line
      value: Como puede ser que el Cybertrash tenga tantos bugs, quiero hablar con
        el jefe ya mismo
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[3].line
      value: "C\xF3mo se atreven a ignorarme"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[4].line
      value: Ya callate por favor, me duele la cabeza
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[5].line
      value: "Quisiera hablar con el jefe de la compa\xF1\xEDa, no puede ser que
        mi juego favorito el Cybertrash no tenga autos flotadores y objetos que atraviesan
        las paredes. Necesito una explicaci\xF3n"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: dialogueLines.Array.data[6].line
      value: "Ese es el problema, la empresa no puede trabajar bien, hubo un mosquito
        que estuvo molestando a todo el personal. Tendr\xE1s que detenerlo y ayudar
        a la empresa si quieres lograr hablar con el jefe"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[0].Line
      value: "\xA1Atenci\xF3n!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[1].Line
      value: Como puede ser que el Cybertrash tenga tantos bugs, quiero hablar con
        el jefe ya mismo
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[2].Line
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[3].Line
      value: "C\xF3mo se atreven a ignorarme"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[4].Line
      value: Ya callate por favor, me duele la cabeza
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[5].Line
      value: "Quisiera hablar con el jefe de la compa\xF1\xEDa, no puede ser que
        mi juego favorito el Cybertrash no tenga autos flotadores y objetos que atraviesan
        las paredes. Necesito una explicaci\xF3n"
      objectReference: {fileID: 0}
    - target: {fileID: 906870224231147973, guid: f04b6b3915743d84caeba89503028761, type: 3}
      propertyPath: _dialogueLines.Array.data[6].Line
      value: "Ese es el problema, la empresa no puede trabajar bien, hubo un mosquito
        que estuvo molestando a todo el personal. Tendr\xE1s que detenerlo y ayudar
        a la empresa si quieres lograr hablar con el jefe"
